---
// The Radar: every weekly scan, every verdict (docs/scan-plan.md, step 37). Once a week a
// fresh session reads each open node against what the world did that week and writes a record
// to data/scans/; the export script checks it and hands it to this page. The point of showing
// all of it, including the weeks where nothing happened, is that a reader can watch the tree
// being watched instead of taking it on faith.
import Base from '../layouts/Base.astro';
import { tree } from '../lib/tree';
import {
  scans, latestScan, verdictLabel, verdictMeaning, scopeLabel, scanSummary, plainCount, ranAtLabel,
  type Scan, type ScanItem, type Verdict,
} from '../lib/scans';

const VERDICT_ORDER: Verdict[] = ['resolved', 'moved', 'flagged', 'noted', 'quiet'];
const older = scans.scans.slice(1);
const waiting = scans.waiting_on_john;

// Items grouped by the chain link their node sits on, in the order the home page reads the
// chain. The window and the Contact Clause are not links, so they fall in at the end with
// their own plain names, which is where the factor table puts them.
function groupByLink(scan: Scan): { letter: string; link: string; name: string; path: string; items: ScanItem[] }[] {
  return tree.factors
    .map((f) => ({
      letter: f.letter,
      link: f.chain_link,
      name: f.name,
      path: f.path,
      items: scan.items.filter((i) => i.factor === f.letter),
    }))
    .filter((g) => g.items.length > 0);
}

const groups = latestScan ? groupByLink(latestScan) : [];
const description = latestScan
  ? `The Belt Equation's weekly scan: ${scanSummary(latestScan)} on ${latestScan.date}. Every node checked, what was searched, what was found, and the verdict.`
  : "The Belt Equation's weekly scan of the tree against the news. The first scan has not run yet.";
---

<Base title="The Radar — The Belt Equation" description={description}>
  <section class="hero">
    <p class="eyebrow">The Radar</p>
    <h1>Sixty tests, checked against the news every Sunday</h1>
    <p class="lede">
      Every node in the tree carries a test that says exactly what would count as it having happened. Once a
      week a fresh session searches for what the world did against each of those tests and writes down what it
      found, whether or not anything moved.
    </p>
    <p class="dim" style="font-size: 14px;">
      The scan may change a number by a small amount with a public source behind it, and may mark a node as
      having happened when two independent records agree. Anything beyond that, it leaves for John and says so.
      Each record is a file in the repository, written once and never edited; the site refuses to build if one
      of them does not add up.
    </p>
  </section>

  {!latestScan && (
    <section class="section narrow">
      <div class="callout">
        <h3>No scan yet</h3>
        <p>
          The first weekly scan has not run. When it does, this page fills with what it read and what it found.
          The procedure it follows is in the repository, at <code>docs/scan-procedure.md</code>.
        </p>
      </div>
    </section>
  )}

  {latestScan && (
    <section class="section">
      <div class="shead">
        <h2>The latest scan</h2>
        <span>{latestScan.date}, reading {scopeLabel[latestScan.scope]}</span>
      </div>

      {latestScan.test && (
        <div class="callout test-callout">
          <h3>This is a test record, not a real scan</h3>
          <p>
            Nothing in it happened. It was written by hand so that this page, the home page and the node pages
            had something to show before the first real scan ran. No number in the tree was changed on the
            strength of it, and every source it lists is an example address that goes nowhere.
          </p>
        </div>
      )}

      <div class="scan-head">
        <div class="scan-facts">
          <p class="scan-line">{scanSummary(latestScan)}.</p>
          <p class="dim scan-meta">
            {latestScan.searches} searches across {latestScan.nodes_checked} node{latestScan.nodes_checked === 1 ? '' : 's'},
            read against the tree as it stood that day (<a href={`https://github.com/jfredson/belt-equation/tree/${latestScan.commit_before}`} rel="noopener">this version</a>). The run finished {ranAtLabel(latestScan)}.
            The record is <code>data/scans/{latestScan.file}</code>.
          </p>
        </div>
        <div class="verdict-counts">
          {VERDICT_ORDER.filter((v) => latestScan.counts[v] > 0).map((v) => (
            <span class={`badge v-${v}`}>{latestScan.counts[v]} · {verdictLabel[v]}</span>
          ))}
        </div>
      </div>

      {waiting.length > 0 && (
        <div class="waiting">
          <h3>Waiting on John</h3>
          <p class="dim">
            {plainCount(waiting.length)} thing{waiting.length === 1 ? '' : 's'} the scan found and was not allowed to act on by
            itself. Each stays on this list until a later scan checks that node again, or a ledger entry picks it up.
          </p>
          <ul class="waiting-list">
            {waiting.map((w) => (
              <li>
                <a href={w.path}>{w.node_name}</a>
                <span class="dim"> · {w.chain_link} · flagged {w.scan_date}{w.test ? ', in the test record' : ''}</span>
                <p>{w.for_john}</p>
              </li>
            ))}
          </ul>
        </div>
      )}

      {groups.map((g) => (
        <div class="link-group">
          <div class="link-head">
            <h3><span class="dim">Category: </span>{g.link}</h3>
            <span class="dim"><a href={g.path}>{g.letter}, {g.name}</a> · {g.items.length} node{g.items.length === 1 ? '' : 's'} read</span>
          </div>
          <div class="scan-cards">
            {g.items.map((item) => (
              <article class={`scan-card v-${item.verdict}`}>
                <div class="card-top">
                  <a class="card-name" href={item.path}>{item.node_name}</a>
                  <span class={`badge v-${item.verdict}`}>{verdictLabel[item.verdict]}</span>
                </div>
                <p class="card-found">{item.found}</p>
                {item.for_john && (
                  <p class="card-john"><strong>For John:</strong> {item.for_john}</p>
                )}
                <div class="card-foot">
                  {item.ledger && (
                    item.ledger.path
                      ? <a class="card-ledger" href={item.ledger.path}>The ledger entry for this</a>
                      : <span class="card-ledger dim">Ledger entry <code>{item.ledger.id}</code>, not written yet</span>
                  )}
                  {item.sources.length > 0 && (
                    <span class="card-sources">
                      {item.sources.map((s, i) => (
                        <a href={s} rel="noopener nofollow">source {item.sources.length > 1 ? i + 1 : ''}</a>
                      ))}
                    </span>
                  )}
                  <details class="card-queries">
                    <summary>What was searched</summary>
                    <ul>{item.queries.map((q) => <li>{q}</li>)}</ul>
                  </details>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}

      <div class="verdict-key">
        <h3>What the five verdicts mean</h3>
        <dl>
          {VERDICT_ORDER.map((v) => (
            <>
              <dt><span class={`badge v-${v}`}>{verdictLabel[v]}</span></dt>
              <dd>{verdictMeaning[v]}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>
  )}

  {older.length > 0 && (
    <section class="section">
      <div class="shead"><h2>Earlier scans</h2><span>{older.length} of them, newest first</span></div>
      {older.map((scan) => (
        <details class="old-scan">
          <summary>
            <span class="old-date">{scan.date}</span>
            <span class="old-sum">{scanSummary(scan)}</span>
            {scan.test && <span class="badge v-test">Test record</span>}
          </summary>
          <ul class="old-items">
            {scan.items.map((item) => (
              <li>
                <span class={`badge v-${item.verdict}`}>{verdictLabel[item.verdict]}</span>
                <a href={item.path}>{item.node_name}</a>
                <p>{item.found}</p>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </section>
  )}

  <p class="dim home-meta">
    {scans.counts.scans === 0
      ? 'No scan has run yet.'
      : `${scans.counts.scans} scan${scans.counts.scans === 1 ? '' : 's'} on the record, ${scans.counts.items} node check${scans.counts.items === 1 ? '' : 's'} in all${scans.counts.test_scans ? `, ${scans.counts.test_scans} of them a hand-made test record` : ''}.`}
    <span class="sep">|</span><a href="/tree/">The tree</a><span class="sep">|</span><a href="/story/">What has changed</a>
  </p>
</Base>
