---
// The Radar: every weekly scan, every verdict (docs/scan-plan.md, step 37). Once a week a
// fresh session reads each open node against what the world did that week and writes a record
// to data/scans/; the export script checks it and hands it to this page. The point of showing
// all of it, including the weeks where nothing happened, is that a reader can watch the tree
// being watched instead of taking it on faith.
// 2026-10-21: the card grid became one column of checks that open and close
// (components/ScanEntries.astro), with the counts under the heading, as John approved.
// 2026-10-27: the discovery watch (docs/discovery-sources.md, scan procedure step 3d) gets its own
// short list near the top: what the scan found in our own solar system, newest first, which moves
// no number. A record that holds only that pass is never "the latest scan" here.
import Base from '../layouts/Base.astro';
import ScanEntries from '../components/ScanEntries.astro';
import { longDate, proseDates } from '../lib/dates';
import {
  scans, readings, latestScan, verdictLabel, verdictMeaning, scopeLabel, scanSummary, scanCountLine, plainCount, ranAtLabel,
  type Verdict,
} from '../lib/scans';

const VERDICT_ORDER: Verdict[] = ['resolved', 'moved', 'flagged', 'noted', 'quiet'];
const older = readings.slice(1);
const waiting = scans.waiting_on_john;
const FOUND_SHOWN = 10;
const found = scans.discoveries.slice(0, FOUND_SHOWN);
const lastPass = scans.last_discovery_pass;

const description = latestScan
  ? `The Belt Equation's weekly scan: ${scanSummary(latestScan)} on ${longDate(latestScan.date)}. Every node checked, what was searched, what was found, and the verdict.`
  : "The Belt Equation's weekly scan of the tree against the news. The first scan has not run yet.";
---

<Base title="The Radar · The Belt Equation" description={description}>
  <section class="hero">
    <p class="eyebrow">The Radar</p>
    <h1>Sixty tests, checked against the news every Sunday</h1>
    {latestScan && <p class="reading-count-line">Latest scan, <a href="#latest-scan">{longDate(latestScan.date)}</a>: {scanCountLine(latestScan)}</p>}
    <p class="lede">
      Every node in the tree carries a test that says exactly what would count as it having happened. Once a
      week a fresh session searches for what the world did against each of those tests and writes down what it
      found, whether or not anything moved.
    </p>
    <p class="dim" style="font-size: 14px;">
      The scan may change a number by a small amount with a public source behind it, and may mark a node as
      having happened when two independent records agree. Anything beyond that, it leaves for me and says so.
      Each record is a file in the repository, written once and never edited; the site refuses to build if one
      of them does not add up.
    </p>
  </section>

  {lastPass && (
    <section class="section">
      <div class="shead" id="found">
        <h2>Found in our solar system</h2>
        <span>sources last read {longDate(lastPass.date)}</span>
      </div>
      <p class="dim" style="font-size: 14px;">
        Since 27 October 2026 the scan also reads a fixed list of {lastPass.sources} primary sources (the Minor Planet
        Center, the observatories, the space agencies, the week's planetary science papers) for discoveries and
        firsts in our own solar system: a new body, a first image, a first measurement, a mission arriving
        somewhere. None of it moves a number. Each find is written down here, and the ones worth a story get a
        post in <a href="/news/">the news</a>.
      </p>
      {lastPass.found === 0 && (
        <p class="dim" style="font-size: 14px;">
          The last pass, on {longDate(lastPass.date)}, read {lastPass.sources} sources and found nothing new.
        </p>
      )}
      {found.length > 0 && (
        <ul class="found-list">
          {found.map((d) => (
            <li>
              <span class="found-date">{longDate(d.date)}</span>
              <a href={d.source} rel="noopener">{d.title}</a>
              <p>
                {proseDates(d.found)}{' '}
                {d.node
                  ? <>Touches <a href={d.node.path}>{d.node.name}</a>.</>
                  : <span class="dim">Touches no step of the tree.</span>}
              </p>
              <span class="dim found-meta">
                {d.via ? `Surfaced by ${d.via}; ` : ''}from the pass of {longDate(d.scan_date)}, record <code>data/scans/{d.scan_file}</code>{d.test ? ', a test record' : ''}.
              </span>
            </li>
          ))}
        </ul>
      )}
      {scans.counts.discoveries > FOUND_SHOWN && (
        <p class="dim" style="font-size: 14px;">
          The newest {FOUND_SHOWN} of {scans.counts.discoveries}; the rest are in the records under <code>data/scans/</code>.
        </p>
      )}
    </section>
  )}

  {!latestScan && (
    <section class="section narrow">
      <div class="callout">
        <h3>No scan yet</h3>
        <p>
          The first weekly scan has not run. When it does, this page fills with what it read and what it found.
          The procedure it follows is in the repository, at <code>docs/scan-procedure.md</code>.
        </p>
      </div>
    </section>
  )}

  {latestScan && (
    <section class="section">
      <div class="shead" id="latest-scan">
        <h2>The latest scan</h2>
        <span>{longDate(latestScan.date)}, reading {scopeLabel[latestScan.scope]}</span>
      </div>

      {latestScan.test && (
        <div class="callout test-callout">
          <h3>This is a test record, not a real scan</h3>
          <p>
            Nothing in it happened. It was written by hand so that this page, the home page and the node pages
            had something to show before the first real scan ran. No number in the tree was changed on the
            strength of it, and every source it lists is an example address that goes nowhere.
          </p>
        </div>
      )}

      <div class="scan-head">
        <div class="scan-facts">
          <p class="scan-line">{scanSummary(latestScan)}.</p>
          <p class="dim scan-meta">
            {latestScan.searches} searches across {latestScan.nodes_checked} node{latestScan.nodes_checked === 1 ? '' : 's'},
            read against the tree as it stood that day (<a href={`https://github.com/jfredson/belt-equation/tree/${latestScan.commit_before}`} rel="noopener">this version</a>). The run finished {ranAtLabel(latestScan)}.
            The record is <code>data/scans/{latestScan.file}</code>.
          </p>
          <p class="reading-tally">Checks marked Nothing new start closed; open one to see the full note, its searches and its sources.</p>
        </div>
      </div>

      {waiting.length > 0 && (
        <div class="waiting">
          <h3>Waiting on me</h3>
          <p class="dim">
            {plainCount(waiting.length)} thing{waiting.length === 1 ? '' : 's'} the scan found and was not allowed to act on by
            itself. Each stays on this list until a later scan checks that node again, or a ledger entry picks it up.
          </p>
          <ul class="waiting-list">
            {waiting.map((w) => (
              <li>
                <a href={w.path}>{w.node_name}</a>
                <span class="dim"> · {w.chain_link} · flagged {longDate(w.scan_date)}{w.test ? ', in the test record' : ''}</span>
                <p>{w.for_john}</p>
              </li>
            ))}
          </ul>
        </div>
      )}

      <ScanEntries scan={latestScan} />

      <div class="verdict-key">
        <h3>What the five verdicts mean</h3>
        <dl>
          {VERDICT_ORDER.map((v) => (
            <>
              <dt><span class={`badge v-${v}`}>{verdictLabel[v]}</span></dt>
              <dd>{verdictMeaning[v]}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>
  )}

  {older.length > 0 && (
    <section class="section">
      <div class="shead"><h2>Earlier scans</h2><span>{older.length} of them, newest first</span></div>
      {older.map((scan) => (
        <details class="old-scan">
          <summary>
            <span class="old-date">{scan.date}</span>
            <span class="old-sum">{scanSummary(scan)}</span>
            {scan.test && <span class="badge v-test">Test record</span>}
          </summary>
          <div class="old-body"><ScanEntries scan={scan} /></div>
        </details>
      ))}
    </section>
  )}

  <p class="dim home-meta">
    {readings.length === 0
      ? 'No scan has run yet.'
      : `${readings.length} scan${readings.length === 1 ? '' : 's'} on the record, ${scans.counts.items} node check${scans.counts.items === 1 ? '' : 's'} in all${scans.counts.test_scans ? `, ${scans.counts.test_scans} of them a hand-made test record` : ''}${scans.counts.discoveries ? `, ${scans.counts.discoveries} ${scans.counts.discoveries === 1 ? 'discovery' : 'discoveries'} in the solar system` : ''}.`}
    <span class="sep">|</span><a href="/tree/">The tree</a><span class="sep">|</span><a href="/about/#story">What has changed</a>
  </p>
</Base>
