---
// The home page: the number first, then the chain. Redesigned 2026-09-19 so a reader who has
// never heard of the project can take in the first screen without knowing what a factor is.
// Every figure comes from tree.json (scripts/export.py); the copy for the seven links is here.
import Base from '../layouts/Base.astro';
import { tree, percent, factorByLetter, snapshots, ledger, direction, movePoints } from '../lib/tree';
import { latestScan, scanSummary } from '../lib/scans';

const numbers = tree.numbers;
const headlineKey = tree.headline_tier;
const DEFAULT_SCENARIO = 'baseline';

// The seven links of the chain, in the order they are read. W (the window) is the dial, not a
// link; C (the Contact Clause) sits beside the equation and is never multiplied in. The short
// name of each link comes from the factor table in scripts/export.py, so that the home page,
// the Radar page and the scan records all call a link the same thing.
const LINKS = [
  { letter: 'L', title: 'Getting to orbit has to get cheap.', sub: 'A fully reusable heavy rocket flying often, launch under $200 a kilogram, fuel transferred in orbit.' },
  { letter: 'E', title: 'There has to be power out there.', sub: 'A reactor running on the surface of the Moon. Solar gets thin past Mars.' },
  { letter: 'D', title: 'Ships fast enough to make the trip routine.', sub: 'Nuclear propulsion in regular use, and a permanent crewed site somewhere past the Moon.' },
  { letter: 'B', title: 'Bodies that hold up.', sub: 'Living off Earth long term by some route, radiation dose halved, life support that recycles for a year.' },
  { letter: 'M', title: 'A reason for people to go.', sub: 'Something made off Earth and sold at a profit, and a hundred people paid to work up there.' },
  { letter: 'R', title: 'Governments that don’t wreck it.', sub: 'Programs that outlive elections and recessions. Resource rights the big powers recognise.' },
  { letter: 'A', title: 'A seat for me.', sub: 'A job whose holders rotate off Earth, reached through the training and choices I make now.' },
].map((l) => ({ ...l, short: factorByLetter(l.letter)?.chain_link ?? l.letter }));

// One line per scenario for the dial. Keys match data/scenarios.toml.
const DIAL: Record<string, { label: string; when: string; note: string }> = {
  baseline: { label: '2071', when: 'by 2071', note: 'If I live about as long as a man my age is expected to: roughly to 2071. This is the default, and the number I hold myself to.' },
  moderate: { label: '2080', when: 'by 2080', note: 'If medicine adds about a decade to a life like mine.' },
  strong: { label: '2095', when: 'by 2095', note: 'If I make it to 109. Strong life extension, the kind that is being seriously worked on but has not arrived.' },
  radical: { label: '2136', when: 'by 2136', note: 'A 150-year life. This is the long shot the whole project is built to keep in view.' },
  open: { label: 'No limit', when: 'with no deadline', note: 'Aging solved outright. The odds stop depending on the calendar and depend only on whether human industry ever reaches that far.' },
};

// How far the headline and each link moved between the last two runs of the tree, from the
// committed snapshots (docs/ledger-plan.md, step 31). A run in which the tree itself changed is
// not a like-for-like comparison with the one before it, and the line under the number says so.
const move = snapshots.change;
const movedRun = move ? ledger.runs.find((r) => r.key === move.to) : undefined;
const structuralMove = move
  ? ledger.entries.some((e) => e.snapshot === move.to && e.kind === 'structure')
  : false;
const movedEntries = movedRun ? movedRun.entries.length : 0;

// Everything the dial needs, serialised once for the inline script.
const scenarios = tree.scenarios.map((s) => {
  const d = DIAL[s.key] ?? { label: s.key, when: s.key, note: s.name };
  const n = numbers.available
    ? {
        headline: numbers.tiers[headlineKey][s.key],
        a1: numbers.tiers['A1'][s.key],
        t3: numbers.tiers['T3'][s.key],
        a2t1: numbers.a2_at_tier1 ? numbers.a2_at_tier1[s.key] : null,
        links: Object.fromEntries(LINKS.map((l) => [l.letter, numbers.chain[l.letter]?.[s.key] ?? null])),
        headlineMove: move ? move.tiers[headlineKey]?.[s.key] ?? null : null,
        moves: move
          ? Object.fromEntries(LINKS.map((l) => [l.letter, move.chain[l.letter]?.[s.key] ?? null]))
          : null,
      }
    : null;
  return { key: s.key, ...d, ...n };
});
const current = scenarios.find((s) => s.key === DEFAULT_SCENARIO) ?? scenarios[0];

function fmt(p: number | null | undefined): string {
  if (p === null || p === undefined) return 'not yet';
  const v = p * 100;
  return (v < 10 ? v.toFixed(1) : Math.round(v).toString()) + '%';
}
function weakest(s: typeof current) {
  if (!s.links) return null;
  let best: { letter: string; p: number } | null = null;
  for (const l of LINKS) {
    const p = s.links[l.letter];
    if (p !== null && (best === null || p < best.p)) best = { letter: l.letter, p };
  }
  return best;
}
const w = weakest(current);
const weakestLink = w ? LINKS.find((l) => l.letter === w.letter) : null;

// The strip under the headline (docs/scan-plan.md, step 37): one line saying when the tree was
// last read against the news and what came of it. It is how a first-time visitor learns that
// the number is watched rather than posted once and left. When exactly one node moved or
// resolved, the line names it; otherwise the Radar page has the detail.
const movers = latestScan ? latestScan.items.filter((i) => i.verdict === 'moved' || i.verdict === 'resolved') : [];
const loneMover = movers.length === 1 ? movers[0] : null;
const equationFactors = tree.factors.filter((f) => f.letter !== 'C');
const contact = factorByLetter('C');
---

<Base>
  <section class="home-hero">
    <div class="home-hero-main">
      <p class="eyebrow">One man's odds of leaving Earth, tracked in public</p>
      <p class="big-number" data-bind="headline">{fmt(current.headline)}</p>
      <h1 class="big-claim">The chance that, before I die, I live and work in a solar system where human industry reaches beyond Earth and Mars.</h1>
      <p class="big-sub"><span data-bind="windowLine">That is {current.when}.</span> Nobody knows how long I get, so the dial lets you change that assumption and watch the odds move.</p>
      <p class="second-number">That means working rotations out past Mars, where something made off Earth sells at a profit. The nearer thing, a rotation at a station or a lunar base before industry reaches that far, comes out at <strong data-bind="a2t1">{fmt(current.a2t1)}</strong>. That number is reported here beside the headline, not in its place.</p>
      {move && (
        <p class={`headline-move tone-${direction(current.headlineMove).tone}`} data-bind-class="headlineMove">
          <span aria-hidden="true" data-bind="headlineArrow">{direction(current.headlineMove).arrow}</span>
          <span>
            <span data-bind="headlineMove">{movePoints(current.headlineMove)}</span> since the last run of the tree, on {move.to_date}.
            {structuralMove
              ? ' The tree itself changed between those two runs, so they are not measuring quite the same thing.'
              : ''}
            {' '}<a href="/story/">See what changed{movedEntries ? ` — ${movedEntries} entr${movedEntries === 1 ? 'y' : 'ies'}` : ''}</a>.
          </span>
        </p>
      )}
      {latestScan && (
        <p class="scan-strip">
          <span class="strip-dot" aria-hidden="true"></span>
          <span>
            Last checked {latestScan.date}: {scanSummary(latestScan)}{loneMover ? <>: <a href={loneMover.path}>{loneMover.node_name}</a></> : ''}.
            {' '}<a href="/radar/">See the week's reading</a>.
            {latestScan.test && <span class="strip-test">This one is a hand-made test record; no real scan has run yet.</span>}
          </span>
        </p>
      )}
      <div class="ctas">
        <a class="btn" href="#chain">Why so low?</a>
        <a class="btn ghost" href="#who">Who is asking</a>
      </div>
    </div>

    <div class="dial" id="dial">
      <div class="dial-head">
        <span class="dial-label">How long do I get?</span>
        <span class="dial-hint">the W in the equation</span>
      </div>
      <div class="dial-row" role="group" aria-label="Choose how long I live">
        {scenarios.map((s) => (
          <button type="button" class={`dial-btn ${s.key === current.key ? 'on' : ''}`} data-scenario={s.key} aria-pressed={s.key === current.key ? 'true' : 'false'}>{s.label}</button>
        ))}
      </div>
      <p class="dial-note" data-bind="note">{current.note}</p>
      <div class="dial-stats">
        <div><span class="stat" data-bind="a1">{fmt(current.a1)}</span><span class="stat-label">I fly to space at least once</span></div>
        <div><span class="stat" data-bind="a2t1">{fmt(current.a2t1)}</span><span class="stat-label">I work a rotation at a station or lunar base, however far industry has reached</span></div>
        <div><span class="stat" data-bind="t3">{fmt(current.t3)}</span><span class="stat-label">Human industry reaches beyond Earth and Mars at all</span></div>
        <div><span class="stat accent" data-bind="headline">{fmt(current.headline)}</span><span class="stat-label">I'm out there working when it does</span></div>
      </div>
      <p class="dial-foot">These are my odds, against my lifetime. <a href="/run/">Run the same tree against yours</a>.</p>
    </div>
  </section>

  <section class="section who" id="who">
    <div>
      <p class="kicker">Why the name?</p>
      <p>The name comes from the Belters of the TV series <em>The Expanse</em>, the people who live and work in the asteroid belt, far from Earth. Underestimated, and at home where nobody thought people could be. I want to see a solar system like that unfold. This site works out, in public, how likely that is.</p>
    </div>
    <div>
      <p class="kicker">Who is asking</p>
      <p>I'm John, 40, and in training for my current job. I want to leave the planet before I die, and I'd rather know my real odds than keep the wish vague. So I built the probability tree behind this page and let the math tell me which choices in the next few years move the number. Once a year I re-check every link and publish what changed. If you think a number is wrong, <a href="/disagree/">there's a page for that</a>.</p>
    </div>
  </section>

  <section class="section chain" id="chain">
    <div class="chain-head">
      <div>
        <p class="eyebrow">Why so low</p>
        <h2 class="chain-title">Seven things all have to go right.</h2>
        <p class="chain-lede">Each link below is a real thing that has to happen. Any broken link breaks the chain. That is the whole equation: multiply seven maybes together and you get a small number, even when no single link looks hopeless.</p>
      </div>
      <div class="chain-dial">
        <p class="chain-year" data-bind="yearLine">Odds shown {current.when}</p>
        <div class="dial-row" role="group" aria-label="Choose how long I live">
          {scenarios.map((s) => (
            <button type="button" class={`dial-btn ${s.key === current.key ? 'on' : ''}`} data-scenario={s.key} aria-pressed={s.key === current.key ? 'true' : 'false'}>{s.label}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="links">
      {LINKS.map((l, i) => {
        const f = factorByLetter(l.letter);
        const p = current.links ? current.links[l.letter] : null;
        const pct = p === null ? 0 : Math.max(2, Math.round(p * 100));
        return (
          <a class="link" href={f?.path ?? '/tree/'} data-link={l.letter}>
            <span class="link-top"><span class="link-num">{String(i + 1).padStart(2, '0')}</span><span class="link-letter">{l.letter} · {f?.name ?? ''}</span></span>
            <span class="link-title">{l.title}</span>
            <span class="link-sub">{l.sub}</span>
            <span class="link-foot">
              <span class="link-pct" data-bind-link={l.letter}>{fmt(p)}</span>
              <span class="bar"><span class="bar-fill" data-bar={l.letter} style={`width:${pct}%`}></span></span>
              <span class="link-cap">chance this link holds</span>
              {move && (
                <span class={`link-move tone-${direction(current.moves ? current.moves[l.letter] : null).tone}`} data-move-class={l.letter}>
                  <span aria-hidden="true" data-move-arrow={l.letter}>{direction(current.moves ? current.moves[l.letter] : null).arrow}</span>
                  <span data-move={l.letter}>{movePoints(current.moves ? current.moves[l.letter] : null)}</span>
                  <span>since the last run</span>
                </span>
              )}
            </span>
          </a>
        );
      })}
    </div>

    <div class="chain-note">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg>
      <p>
        <span data-bind="weakest">{weakestLink && w ? `In this time frame the weakest link is ${weakestLink.short}, at ${fmt(w.p)}.` : ''}</span>
        {' '}The links lean on each other, so these are not independent dice; the honest math, with every one of the {tree.counts.nodes} smaller steps behind these seven, is on <a href="/method/">the numbers page</a>, and all {tree.counts.nodes} steps are drawn as <a href="/tree/#picture">one picture</a>. There is also an eighth thing I track and never multiply in. It is there too.
      </p>
    </div>

    <p class="equation-line" aria-label="The equation">
      In the notation of the numbers page:
      <span class="term">P</span><span class="op">=</span>
      {equationFactors.map((f, i) => (
        <>
          <a class="term" href={f.path} title={f.name}>{f.letter}</a>
          {i < equationFactors.length - 1 && <span class="op">×</span>}
        </>
      ))}
      {contact && <a class="beside" href={contact.path}>with C beside it, never multiplied in</a>}
    </p>
  </section>

  <section class="section moves">
    <div class="move">
      <p class="kicker">What would move it</p>
      <p>Cheap launch and bodies that tolerate low gravity. Nearly everything else leans on those two. When either one moves, the number at the top moves with it.</p>
    </div>
    <div class="move">
      <p class="kicker">What I can do about it</p>
      <p>Only the last link is mine. I can choose the training I take and the jobs I chase, and the tree tells me which choices raise the odds. That is the real reason this exists.</p>
    </div>
    <div class="move">
      <p class="kicker">Think I'm wrong?</p>
      <p>Good. Every link has a page, a definition of what counts, and a number you can argue with. Changes get a line in the public changelog.</p>
      <a class="btn ghost" href="/disagree/">Argue with a link</a>
    </div>
  </section>

  <p class="dim home-meta">
    {numbers.available
      ? `Numbers from the run of ${numbers.computed_on}, ${numbers.runs.toLocaleString()} play-throughs of the tree per scenario.${numbers.review_status ? ' ' + numbers.review_status : ''}`
      : `The numbers wait on the first probabilities: ${numbers.reason}`}
    <span class="sep">|</span><a href="/method/">How the numbers are computed</a><span class="sep">|</span><a href="/story/">What has changed</a>
  </p>

  <script type="application/json" id="home-scenarios" set:html={JSON.stringify({ scenarios, links: LINKS.map((l) => ({ letter: l.letter, short: l.short })) })}></script>
  <script is:inline>
    (function () {
      var el = document.getElementById('home-scenarios');
      if (!el) return;
      var data = JSON.parse(el.textContent || '{}');
      var byKey = {};
      (data.scenarios || []).forEach(function (s) { byKey[s.key] = s; });
      function fmt(p) {
        if (p === null || p === undefined) return 'not yet';
        var v = p * 100;
        return (v < 10 ? v.toFixed(1) : Math.round(v)) + '%';
      }
      function setAll(name, text) {
        document.querySelectorAll('[data-bind="' + name + '"]').forEach(function (n) { n.textContent = text; });
      }
      function points(d) {
        if (d === null || d === undefined) return 'not known';
        var p = d * 100;
        if (Math.abs(p) < 0.05) return 'unchanged';
        return (p > 0 ? '+' : '\u2212') + Math.abs(p).toFixed(1) + ' points';
      }
      function arrow(d) {
        if (d === null || d === undefined) return '\u00b7';
        var p = d * 100;
        return p > 0.05 ? '\u25b2' : p < -0.05 ? '\u25bc' : '\u2014';
      }
      function tone(d) {
        if (d === null || d === undefined) return 'flat';
        var p = d * 100;
        return p > 0.05 ? 'up' : p < -0.05 ? 'down' : 'flat';
      }
      function apply(key) {
        var s = byKey[key];
        if (!s) return;
        setAll('headline', fmt(s.headline));
        setAll('a1', fmt(s.a1));
        setAll('t3', fmt(s.t3));
        setAll('a2t1', fmt(s.a2t1));
        setAll('windowLine', 'That is ' + s.when + '.');
        setAll('note', s.note);
        setAll('yearLine', 'Odds shown ' + s.when);
        var weakest = null;
        (data.links || []).forEach(function (l) {
          var p = s.links ? s.links[l.letter] : null;
          var pctEl = document.querySelector('[data-bind-link="' + l.letter + '"]');
          var bar = document.querySelector('[data-bar="' + l.letter + '"]');
          if (pctEl) pctEl.textContent = fmt(p);
          if (bar) bar.style.width = (p === null ? 0 : Math.max(2, Math.round(p * 100))) + '%';
          var moved = s.moves ? s.moves[l.letter] : null;
          var moveEl = document.querySelector('[data-move="' + l.letter + '"]');
          var arrowEl = document.querySelector('[data-move-arrow="' + l.letter + '"]');
          var wrapEl = document.querySelector('[data-move-class="' + l.letter + '"]');
          if (moveEl) moveEl.textContent = points(moved);
          if (arrowEl) arrowEl.textContent = arrow(moved);
          if (wrapEl) wrapEl.className = 'link-move tone-' + tone(moved);
          if (p !== null && (weakest === null || p < weakest.p)) weakest = { short: l.short, p: p };
        });
        setAll('weakest', weakest ? 'In this time frame the weakest link is ' + weakest.short + ', at ' + fmt(weakest.p) + '.' : '');
        setAll('headlineMove', points(s.headlineMove));
        setAll('headlineArrow', arrow(s.headlineMove));
        document.querySelectorAll('[data-bind-class="headlineMove"]').forEach(function (n) {
          n.className = 'headline-move tone-' + tone(s.headlineMove);
        });
        document.querySelectorAll('.dial-btn').forEach(function (b) {
          var on = b.getAttribute('data-scenario') === key;
          b.classList.toggle('on', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      }
      document.querySelectorAll('.dial-btn').forEach(function (b) {
        b.addEventListener('click', function () { apply(b.getAttribute('data-scenario')); });
      });
    })();
  </script>
</Base>
