---
// News: one post per event of note, newest first, with the opening post pinned at the top (tracker
// pattern, rules 4.10 to 4.13; ruled by John 2026-10-18). Copied from Outrunning Ageing's, the model.
import Base from '../../layouts/Base.astro';
import { longDate } from '../../lib/dates';
import { datedPosts, opener, postPath, KIND_LABEL, wordCount } from '../../lib/news';

const posts = await datedPosts();
const start = await opener();
---

<Base title="News: what moved my odds, and the missions I follow · The Belt Equation" description="One post for each change in my odds a reader would want explained, and short posts marked mission news about space missions worth following, whether or not they move the number.">
  <section class="hero">
    <p class="eyebrow">News</p>
    <h1>What moved the number, and the missions I follow</h1>
    <p class="lede">Most posts here explain a change in my odds: a step settled, a probability revised, a famous claim held against a step's test, the headline moving. Some, marked mission news, are about <a href="/missions/">a space mission worth following</a> on the way out, whether or not it moves them. Every post says what happened and what it does not mean.</p>
  </section>

  <section class="section">
    {start && (
      <div class="opener">
        <span class="k">Start here</span>
        <h3><a href={postPath(start)}>{start.data.title}</a></h3>
        <p>{start.data.summary}</p>
        <p class="meta">{longDate(start.data.date)} · about {Math.round(wordCount(start.body) / 100) * 100} words · <a href={postPath(start)}>read it</a></p>
      </div>
    )}
    {posts.length === 0 ? (
      <p class="empty-note">No post yet. The first is written the day something of note moves.</p>
    ) : (
      <ul class="news-list">
        {posts.map((p) => (
          <li class="news-item">
            <time datetime={p.data.date}>{p.data.date}</time><span class={`kind${p.data.kind === 'mission-news' ? ' kind-mission' : ''}`}>{KIND_LABEL[p.data.kind]}</span>
            <h3><a href={postPath(p)}>{p.data.title}</a></h3>
            <p>{p.data.summary}</p>
          </li>
        ))}
      </ul>
    )}
    <p class="news-foot">Every entry that moved the number, and every famous thing that did not, is in <a href="/about/#story">the story so far</a>. The weekly readings themselves are on <a href="/radar/">the Radar</a>.</p>
    <p class="news-follow">Follow the news: <a href="/news/feed.xml">the feed</a> · <a href="https://x.com/SentHorizons" rel="noopener">@SentHorizons on X</a>.</p>
  </section>
</Base>
