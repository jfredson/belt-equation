---
// One news post (tracker pattern, rule 4.12), copied from Outrunning Ageing's, the model.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { longDate } from '../../lib/dates';
import { tree, ledger } from '../../lib/tree';
import { allPosts, cardPath, KIND_LABEL, type Post } from '../../lib/news';
import { missions, missionPath } from '../../lib/missions';

export async function getStaticPaths() {
  return (await allPosts()).map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const named = post.data.records.map((id) => {
  const n = tree.nodes.find((x) => x.id === id);
  if (n) return { name: n.name, path: n.path };
  const e = ledger.entries.find((x) => x.id === id);
  return e ? { name: e.title, path: `/about/#${e.id}` } : null;
}).filter(Boolean) as { name: string; path: string }[];
// A mission news post names missions instead of records (tracker pattern rule 4.20).
const namedMissions = post.data.missions.map((id) => missions.missions.find((m) => m.id === id)).filter(Boolean).map((m) => ({ name: m!.short, path: missionPath(m!.id) }));
---

<Base title={`${post.data.title} · The Belt Equation`} description={post.data.summary} image={cardPath(post)}>
  <section class="hero wide">
    <p class="eyebrow"><a href="/news/">News</a> · {longDate(post.data.date)} · {KIND_LABEL[post.data.kind]}</p>
    <h1>{post.data.title}</h1>
    <p class="lede">{post.data.summary}</p>
  </section>
  <article class="post">
    <Content />
    {(named.length > 0 || namedMissions.length > 0 || post.data.sources.length > 0) && (
      <section class="post-record">
        {namedMissions.length > 0 && <p class="rec">On the Missions page: {namedMissions.map((r, i) => <>{i > 0 ? ' · ' : ''}<a href={r.path}>{r.name}</a></>)} · <a href="/missions/">every mission I follow</a>.</p>}
        {named.length > 0 && <p class="rec">The record: {named.map((r, i) => <>{i > 0 ? ' · ' : ''}<a href={r.path}>{r.name}</a></>)}{post.data.reading && <> · the reading of <a href={`/radar/#${post.data.reading}`}>{longDate(post.data.reading)}</a></>} · <a href="/about/#story">the story so far</a>.</p>}
        {post.data.sources.length > 0 && <p class="sources">Sources: {post.data.sources.map((s, i) => <>{i > 0 ? ' · ' : ''}<a href={s.url} rel="noopener">{s.label}</a></>)}.</p>}
      </section>
    )}
    <p class="news-follow">Follow the news: <a href="/news/feed.xml">the feed</a> · <a href="https://x.com/SentHorizons" rel="noopener">@SentHorizons on X</a>.</p>
  </article>
</Base>
