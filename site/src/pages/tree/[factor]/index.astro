---
import Base from '../../../layouts/Base.astro';
import HistoryChart from '../../../components/HistoryChart.astro';
import {
  tree, nodesOf, percent, horizonShort, statusLabel, tierByKey, snapshots, ledger, odds, movePoints,
  band, worthOf, DEFAULT_SCENARIO, type Factor,
} from '../../../lib/tree';

export function getStaticPaths() {
  return tree.factors.map((f) => ({ params: { factor: f.slug }, props: { factor: f } }));
}

const { factor } = Astro.props as { factor: Factor };
const nodes = nodesOf(factor.letter);
const baseline = tree.scenarios[0];
const order = { leaf: 0, mid: 1, root: 2 } as const;
const sorted = [...nodes].sort((a, b) => order[a.horizon] - order[b.horizon] || a.name.localeCompare(b.name));
const isContact = factor.letter === 'C';

// This link's own history: how often every one of its gate nodes held in the same play-through,
// run by run, from the committed snapshots (docs/ledger-plan.md, step 31).
const linkSeries = snapshots.series.chain[factor.letter];
const isLink = Boolean(linkSeries);
const linkMove = snapshots.change ? snapshots.change.chain[factor.letter] ?? null : null;
const gateNodes = (snapshots.latest?.chain_nodes ?? {})[factor.letter] ?? [];

// What would move this link (step 32). For every open step under this factor, what the headline
// would be if it settled yes now, and what it would be if it settled no. Worked out by forcing
// the step and playing the whole tree out again, so these are not guesses written beside a name.
const worth = snapshots.latest?.worth ?? null;
const openWorld = nodes.filter((n) => n.kind === 'world' && n.status === 'open');
const watchRows = openWorld
  .map((n) => ({ node: n, worth: worth?.nodes?.[n.id] ?? null }))
  .filter((r) => r.worth?.reaches_headline)
  .sort((a, b) => (b.worth!.if_yes[DEFAULT_SCENARIO] ?? 0) - (a.worth!.if_yes[DEFAULT_SCENARIO] ?? 0));
const unreached = openWorld.filter((n) => worth?.nodes?.[n.id] && !worth.nodes[n.id].reaches_headline);
const headlineNow = worth?.headline?.[DEFAULT_SCENARIO] ?? null;

// Anything in the ledger that touched a step under this factor.
const ledgerHere = ledger.entries.filter((e) => e.factors.some((f) => f.letter === factor.letter));

const linkIndex = tree.factors.filter((f) => f.letter !== 'C').findIndex((f) => f.letter === factor.letter);
const rank = isContact ? 'Beside the chain' : `Link ${linkIndex + 1} of ${tree.factors.length - 1}`;
const tierName = (k: string) => tierByKey(k)?.name ?? k;
---

<Base title={`${factor.name} — The Belt Equation`} description={`${factor.meaning} The ${nodes.length} events behind the ${factor.name.toLowerCase()} link.`}>
  <section class="hero">
    <p class="eyebrow"><a href="/tree/">The tree</a> · {rank}</p>
    <h1>{factor.name}</h1>
    <p class="lede">{factor.meaning}</p>
    <p class="dim" style="font-size: 14px;">
      {nodes.length} events, {factor.with_probability} with a number{factor.resolved ? `, ${factor.resolved} already happened` : ''}.
      {isContact
        ? ' These four follow the same rules as every other event, but no milestone needs them and the headline number never multiplies them in.'
        : ' Listed by how soon they could be decided: the ones that could go either way by 2031 first, then the ones that take a decade or two, then the ones that play out over the whole window.'}
    </p>
  </section>

  {isLink && (
    <section class="section">
      <HistoryChart
        series={linkSeries}
        labels={Object.fromEntries(tree.scenarios.map((s) => [s.key, s.name.split(',')[0]]))}
        highlight={DEFAULT_SCENARIO}
        title={`How often this link has held, run by run`}
        caption={`This link holds when every one of the ${gateNodes.length} step${gateNodes.length === 1 ? '' : 's'} the headline needs from ${factor.name.toLowerCase()} holds in the same play-through. Drawn from the runs saved in the repository.${linkMove ? ` Since the last run: ${movePoints(linkMove[DEFAULT_SCENARIO])} by 2071.` : ''}`}
        height={200}
      />
    </section>
  )}

  <section class="section">
    <div class="shead">
      <h2>What would move this</h2>
      <span>ranked by what a yes is worth to the headline, by 2071</span>
    </div>
    {watchRows.length > 0 ? (
      <>
        <p class="dim" style="font-size: 14.5px; margin-top: 0;">
          The headline stands at {odds(headlineNow)} by 2071. If one of these settled tomorrow and
          nothing else changed, the whole tree is played out again and the headline lands where the
          figure says. This is the site saying in advance what a milestone is worth, before it
          happens: when one of them lands, the entry that records it quotes what was predicted here.
          {snapshots.noise && (
            <> These come from playing the tree out {snapshots.latest?.run.runs.toLocaleString()} times
            per scenario, which is a throw of the dice: anything smaller than about
            {' '}{band(snapshots.noise[DEFAULT_SCENARIO])} is inside the
            noise, so read the order rather than the last decimal.</>
          )}
        </p>
        <ul class="watchlist">
          {watchRows.map(({ node, worth: w }) => (
            <li>
              <a class="wname" href={node.path}>{node.name}</a>
              <span class="wworth">{worthOf(w!.if_yes[DEFAULT_SCENARIO], snapshots.noise?.[DEFAULT_SCENARIO])} if yes</span>
              <span class="wno">
                {odds(headlineNow)} today · {odds(w!.headline_if_yes[DEFAULT_SCENARIO])} if it happened ·
                {' '}{odds(w!.headline_if_no[DEFAULT_SCENARIO])} if it turned out no
                {' '}({worthOf(w!.if_no[DEFAULT_SCENARIO], snapshots.noise?.[DEFAULT_SCENARIO])})
              </span>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p class="dim" style="font-size: 15px; margin-top: 0;">
        {isContact
          ? 'Nothing here moves the headline, by design. The Contact Clause sits beside the equation and is never multiplied into it, so however these four rungs turn out, the number at the top of the site does not change.'
          : factor.letter === 'W'
            ? 'Nothing here moves the headline directly. How long I live is the dial rather than a link in the chain: it is the question the five scenarios ask, so these steps change which scenario looks plausible rather than the number under any one of them.'
            : 'No open step under this factor is one the headline rests on, so nothing here would move it.'}
      </p>
    )}
    {unreached.length > 0 && watchRows.length > 0 && (
      <p class="dim" style="font-size: 13.5px;">
        {unreached.length} other open step{unreached.length === 1 ? '' : 's'} under this factor
        {unreached.length === 1 ? ' is' : ' are'} worth nothing to the headline, because the headline
        does not rest on {unreached.length === 1 ? 'it' : 'them'} at any remove — {unreached.map((n, i) => (
          <>{i > 0 ? ', ' : ''}<a href={n.path}>{n.name}</a></>
        ))}. Most belong to the tiers above the one the headline asks about.
      </p>
    )}
  </section>

  {ledgerHere.length > 0 && (
    <section class="section">
      <div class="shead">
        <h2>What has moved here</h2>
        <span>from the ledger</span>
      </div>
      <ul class="watchlist">
        {ledgerHere.map((e) => (
          <li>
            <a class="wname" href={`/story/#${e.id}`}>{e.title}</a>
            <span class="wworth">{e.date}</span>
            <span class="wno">{ledger.kinds.find((k) => k.key === e.kind)?.label ?? e.kind}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section">
    <div class="shead">
      <h2>Every step under {factor.name.toLowerCase()}</h2>
      <span>{nodes.length} in all</span>
    </div>
    <ul class="nodelist">
      {sorted.map((n) => (
        <li>
          <div>
            <a class="nname" href={n.path}>{n.name}</a>
            <span class="nid">{n.id}</span>
          </div>
          <div class="nprob">
            {n.kind === 'choice'
              ? <span>{n.current_plan ? 'current plan' : 'alternative'}<small>my own decision, never given a probability</small></span>
              : n.status === 'resolved-yes'
                ? <span>happened<small>{n.resolved_on ?? ''}</small></span>
                : n.status === 'resolved-no'
                  ? <span>did not happen<small>{n.resolved_on ?? ''}</small></span>
                  : n.probability
                    ? <span>{percent(n.probability[baseline.key])}<small>{baseline.key} scenario, as of {n.estimated_on}</small></span>
                    : <span class="dim">no number yet</span>}
          </div>
          <div class="chips">
            <span class="chip">{horizonShort[n.horizon]}</span>
            <span class={`chip ${n.status === 'resolved-yes' ? 'ok' : n.status === 'resolved-no' ? 'no' : ''}`}>{statusLabel[n.status]}</span>
            {n.kind === 'choice' && <span class="chip violet">My decision</span>}
            {n.long_shot && <span class="chip accent">Long shot</span>}
            {n.feeds_tiers.map((t) => <span class="chip">needed for {tierName(t)}</span>)}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
