---
import Base from '../../../layouts/Base.astro';
import { tree, nodesOf, percent, horizonShort, statusLabel, tierByKey, type Factor } from '../../../lib/tree';

export function getStaticPaths() {
  return tree.factors.map((f) => ({ params: { factor: f.slug }, props: { factor: f } }));
}

const { factor } = Astro.props as { factor: Factor };
const nodes = nodesOf(factor.letter);
const baseline = tree.scenarios[0];
const order = { leaf: 0, mid: 1, root: 2 } as const;
const sorted = [...nodes].sort((a, b) => order[a.horizon] - order[b.horizon] || a.name.localeCompare(b.name));
const isContact = factor.letter === 'C';
const linkIndex = tree.factors.filter((f) => f.letter !== 'C').findIndex((f) => f.letter === factor.letter);
const rank = isContact ? 'Beside the chain' : `Link ${linkIndex + 1} of ${tree.factors.length - 1}`;
const tierName = (k: string) => tierByKey(k)?.name ?? k;
---

<Base title={`${factor.name} — The Belt Equation`} description={`${factor.meaning} The ${nodes.length} events behind the ${factor.name.toLowerCase()} link.`}>
  <section class="hero">
    <p class="eyebrow"><a href="/tree/">The tree</a> · {rank}</p>
    <h1>{factor.name}</h1>
    <p class="lede">{factor.meaning}</p>
    <p class="dim" style="font-size: 14px;">
      {nodes.length} events, {factor.with_probability} with a number{factor.resolved ? `, ${factor.resolved} already happened` : ''}.
      {isContact
        ? ' These four follow the same rules as every other event, but no milestone needs them and the headline number never multiplies them in.'
        : ' Listed by how soon they could be decided: the ones that could go either way by 2031 first, then the ones that take a decade or two, then the ones that play out over the whole window.'}
    </p>
  </section>

  <section class="section">
    <ul class="nodelist">
      {sorted.map((n) => (
        <li>
          <div>
            <a class="nname" href={n.path}>{n.name}</a>
            <span class="nid">{n.id}</span>
          </div>
          <div class="nprob">
            {n.kind === 'choice'
              ? <span>{n.current_plan ? 'current plan' : 'alternative'}<small>my own decision, never given a probability</small></span>
              : n.status === 'resolved-yes'
                ? <span>happened<small>{n.resolved_on ?? ''}</small></span>
                : n.status === 'resolved-no'
                  ? <span>did not happen<small>{n.resolved_on ?? ''}</small></span>
                  : n.probability
                    ? <span>{percent(n.probability[baseline.key])}<small>{baseline.key} scenario, as of {n.estimated_on}</small></span>
                    : <span class="dim">no number yet</span>}
          </div>
          <div class="chips">
            <span class="chip">{horizonShort[n.horizon]}</span>
            <span class={`chip ${n.status === 'resolved-yes' ? 'ok' : n.status === 'resolved-no' ? 'no' : ''}`}>{statusLabel[n.status]}</span>
            {n.kind === 'choice' && <span class="chip violet">My decision</span>}
            {n.long_shot && <span class="chip accent">Long shot</span>}
            {n.feeds_tiers.map((t) => <span class="chip">needed for {tierName(t)}</span>)}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
