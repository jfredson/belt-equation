---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Starfield from '../components/Starfield.astro';
import { tree } from '../lib/tree';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'The Belt Equation',
  description = 'What is the probability that I become a Belter before I die? A public, long-horizon prediction project: a tree of breakthroughs, each with a probability anyone can argue with.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the theme before first paint so there is no flash on load. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <meta id="theme-color-meta" name="theme-color" content="#08070f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Fredrickson" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Belt Equation" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="space-bg" aria-hidden="true">
      <div class="galaxy"></div>
      <div class="core"></div>
      <Starfield count={150} />
    </div>
    <Nav />
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <span class="footer-brand">The Belt Equation</span>
          <p class="footer-tag">A public, long-horizon prediction project. Every number on this site is computed from the tree in the public repository, never chosen by hand.</p>
          <p class="footer-links">
            <a href="/tree/">The tree</a>
            <a href="/radar/">This week’s reading</a>
            <a href="/method/">How the numbers are computed</a>
            <a href="/story/">The story so far</a>
            <a href="/disagree/">Disagree with something</a>
            <a href="https://github.com/jfredson/belt-equation" rel="noopener">Source on GitHub</a>
            <a href="https://sentient-horizons.com" rel="noopener">Sentient Horizons</a>
          </p>
          <p class="footer-meta">
            © {currentYear} John Fredrickson, with Claude as a working partner. Tree exported {tree.exported_on}{tree.commit ? ` from commit ${tree.commit}` : ''}: {tree.counts.nodes} nodes, {tree.counts.with_probability} with probabilities.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
