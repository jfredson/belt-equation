---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Starfield from '../components/Starfield.astro';
import { tree } from '../lib/tree';
import { longDate } from '../lib/dates';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string; // a page's own preview picture (a news post's card); the site's otherwise
}

const {
  title = 'The Belt Equation',
  description = 'What is the probability that, before I die, I live and work in a solar system where human industry reaches beyond Earth and Mars? A public, long-horizon prediction project: a tree of breakthroughs, each with a probability anyone can argue with.',
  noindex = false,
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The preview picture link cards show (site/public/social-preview.png, made by scripts/social-image.mjs); an absolute address, as the tags require.
const socialImage = new URL(image ?? '/social-preview.png', Astro.site).href;
const currentYear = new Date().getFullYear();
// The footer's "Last built 7 October 2026" uses longDate from src/lib/dates.ts (shared with the
// home page's last-checked strip since 2026-10-17); the design standard writes dates out there.
// Bump when the icon set changes, so browsers that keep their own copy of the icon (Safari above
// all) fetch the new one (2026-10-23, family-wide on John's word). The same tag is in
// public/site.webmanifest.
const iconVersion = '2';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the theme before first paint so there is no flash on load. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <meta id="theme-color-meta" name="theme-color" content="#070a0e" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Andrew Fredrickson" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${iconVersion}`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32.png?v=${iconVersion}`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`/favicon-16.png?v=${iconVersion}`} />
    <link rel="icon" href={`/favicon.ico?v=${iconVersion}`} sizes="any" />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${iconVersion}`} />
    <link rel="manifest" href={`/site.webmanifest?v=${iconVersion}`} />
    <link rel="alternate" type="application/rss+xml" title="The Belt Equation · News" href="/news/feed.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Belt Equation" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Belt Equation: the chance that, before I die, I live and work in a solar system where human industry reaches beyond Earth and Mars." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    {/* The Ore skin's sky (ruled 2026-10-17): the belt, a faint diagonal band with the stars gathered into it; no core. */}
    <div class="space-bg" aria-hidden="true">
      <div class="galaxy"></div>
      <Starfield count={150} />
    </div>
    <Nav />
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <span class="footer-brand">The Belt Equation</span>
          <p class="footer-tag">A public, long-horizon prediction project. Every number on this site is computed from the tree in the public repository.</p>
          <p class="footer-links">
            <a href="/tree/">The tree</a>
            <a href="/run/">Your own odds</a>
            <a href="/radar/">This week’s reading</a>
            <a href="/about/#method">How the numbers are computed</a>
            <a href="/about/#story">The story so far</a>
            <a href="/feedback/">Feedback</a>
            <a href="https://github.com/jfredson/belt-equation" rel="noopener">Source on GitHub</a>
          </p>
          <p class="footer-meta">
            © {currentYear} John Andrew Fredrickson. Last built {longDate(tree.exported_on)}{tree.commit ? ` (version ${tree.commit})` : ''} from a tree of {tree.counts.nodes} events, {tree.counts.with_probability} with a probability. Free to reuse with credit (<a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>); code under the MIT licence. Please credit as: <cite>The Belt Equation</cite>, by John Andrew Fredrickson, a Sentient Horizons project, <a href="https://beltequation.com/">beltequation.com</a>.
          </p>
          <p class="footer-parent"><a href="https://sentient-horizons.com/projects/" rel="noopener">A Sentient Horizons project.</a></p>
          <p class="footer-follow"><a href="https://x.com/SentHorizons" rel="noopener">Follow on X</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
